# =============================================================================
# Configurações Obrigatórias do Bot no Stoat
# =============================================================================
# Token do bot gerado em Configurações -> Meus Bots -> (seu bot) -> Token
STOAT_TOKEN=seu_token_aqui

# URL da API da instância do Stoat.
# Use https://stoat.chat/api para a instância oficial,
# ou a URL da sua instância self-hosted (ex: https://chat.suaempresa.gov.br/api).
STOAT_API_URL=https://stoat.chat/api

# Prefixo dos comandos de texto (o Stoat não possui Slash Commands).
# Ex: com "!" o comando fica "!matricula 12345678"
COMMAND_PREFIX=!

# =============================================================================
# Configuração do Servidor Web (Dashboard)
# =============================================================================
PORT=3000

# Interface em que o Docker publica a porta. Mantenha 127.0.0.1: o acesso
# externo deve passar pelo Tailscale. Use 0.0.0.0 apenas com consciência.
BIND_ADDRESS=127.0.0.1

# =============================================================================
# (RECOMENDADO) Login com Google no Dashboard
# =============================================================================
# Sem estas variáveis o Dashboard fica ABERTO para quem alcançar a porta.
# Credenciais criadas em: https://console.cloud.google.com/apis/credentials
# (Tipo "ID do cliente OAuth" -> "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails autorizados a entrar, separados por vírgula.
# Autenticar no Google NÃO basta: a conta precisa estar nesta lista.
ALLOWED_EMAILS=

# Endereço público do Dashboard (usado para montar o redirect do OAuth).
# Ex.: https://flexbot.tail7e6cc2.ts.net
PUBLIC_URL=

# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório:
#   openssl rand -hex 32
# Se ficar vazio, um segredo temporário é criado e as sessões caem a cada restart.
SESSION_SECRET=

# =============================================================================
# (OPCIONAL) Fallbacks / Padrões de Servidor, Cargo e Canal
# =============================================================================
# Nota: O Servidor, Cargo e Canal são definidos dinamicamente na Dashboard Web ao criar cada regra!
# Preencha abaixo apenas se quiser utilizar um valor padrão de fallback.
SERVER_ID=
ROLE_ID=
ALLOWED_CHANNEL_ID=
